{
	"name": "chymy",
	"version": "0.3.0",
	"description": "scraping library",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"changeset": "changeset",
		"lint": "eslint .",
		"prettier": "prettier --write .",
		"test": "vitest run --disable-console-intercept",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/Ennoriel/chymy.git"
	},
	"keywords": [
		"typescript"
	],
	"author": "Maxime Dupont",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Ennoriel/chymy/issues"
	},
	"homepage": "https://github.com/Ennoriel/chymy",
	"dependencies": {
		"chyme": "^3.2.1",
		"node-html-parser": "^9.0.4",
		"xml-js": "^1.6.11"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.3",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"prettier": "^3.9.7",
		"tsdown": "^0.23.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "8.3.0",
		"vitest": "^5.0.1"
	},
	"type": "module"
}
