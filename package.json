{
	"name": "chymy",
	"version": "0.3.0",
	"description": "scraping library",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"changeset": "changeset",
		"lint": "eslint --ignore-path .gitignore .",
		"prettier": "prettier --write .",
		"test": "vitest run --disable-console-intercept",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/Ennoriel/chymy.git"
	},
	"keywords": [
		"typescript"
	],
	"author": "Maxime Dupont",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Ennoriel/chymy/issues"
	},
	"homepage": "https://github.com/Ennoriel/chymy",
	"dependencies": {
		"chyme": "^2.0.4",
		"node-html-parser": "^6.1.13",
		"xml-js": "^1.6.11"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.7",
		"@types/node": "^20.16.3",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.1.0",
		"prettier": "^3.3.3",
		"tsdown": "^0.23.0",
		"typescript": "^5.5.4",
		"vitest": "^2.1.1"
	},
	"type": "module"
}
