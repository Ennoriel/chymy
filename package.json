{
	"name": "chymy",
	"version": "0.3.0",
	"description": "scraping library",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"changeset": "changeset",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test": "vitest run --disable-console-intercept",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/Ennoriel/chymy.git"
	},
	"keywords": [
		"typescript"
	],
	"author": "Maxime Dupont",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Ennoriel/chymy/issues"
	},
	"homepage": "https://github.com/Ennoriel/chymy",
	"dependencies": {
		"chyme": "^3.2.1",
		"node-html-parser": "^9.0.4",
		"xml-js": "^1.6.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@changesets/cli": "^3.0.3",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^22.20.3",
		"tsdown": "^0.23.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"type": "module"
}
